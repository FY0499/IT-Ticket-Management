        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\nconst form = $('On form submission').item.json;\n\nconst slaHoursMap = { 'حرجة': 2, 'عالية': 8, 'متوسطة': 24, 'منخفضة': 72 };\nconst slaHours = slaHoursMap[parsed.priority] || 24;\nconst createdAt = new Date();\nconst slaDeadline = new Date(createdAt.getTime() + slaHours * 60 * 60 * 1000);\nconst ticketId = 'TCK-' + Date.now();\n\nreturn [{ json: {\n  ...parsed,\n  ticketId,\n  employeeName: form['اسم الموظف'],\n  employeeEmail: form['بريد الموظف'],\n  issue: form['وصف المشكلة'],\n  createdAt: createdAt.toISOString(),\n  slaDeadline: slaDeadline.toISOString(),\n  slaHours\n} }];"
